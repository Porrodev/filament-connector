{
    "name": "porro/filament-connector",
    "description": "Site health for Filament 3\u20135: security advisories, end-of-life PHP and Laravel, Filament and Laravel updates and the scheduler, on a panel page and dashboard widget. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "porro"
    ],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "dev-claude/ip-details as 0.3.0",
        "filament/filament": "^3.2|^4.0|^5.0",
        "porro/php-core": "dev-claude/ip-details as 0.3.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Porro\\Filament\\FilamentConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/filament-connector/issues",
        "source": "https://github.com/Porrodev/filament-connector",
        "docs": "https://github.com/Porrodev/filament-connector#readme"
    },
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Porrodev/laravel-connector"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Porrodev/php-core"
        }
    ]
}
