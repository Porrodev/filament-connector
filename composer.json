{
    "name": "porro/filament-connector",
    "description": "Porro connector for Filament 3\u20135: Filament, Livewire and plugin versions plus panel checks, on top of the Laravel connector.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "porro",
        "filament",
        "laravel",
        "monitoring"
    ],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "^0.1.1",
        "filament/filament": "^3.2|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Porro\\Filament\\FilamentConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/filament-connector/issues",
        "source": "https://github.com/Porrodev/filament-connector"
    }
}
