{
    "name": "porro/filament-connector",
    "description": "Site health, suspicious activity and IP blocking for Filament 3\u20135, in your panel: security advisories, end-of-life PHP and Laravel, Filament and Laravel updates and the scheduler, plus probes, failed logins and form floods, blocked in the app, at Cloudflare or in nginx. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "blocking",
        "firewall",
        "cloudflare",
        "porro"
    ],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "^0.3.5",
        "filament/filament": "^3.2|^4.0|^5.0",
        "porro/php-core": "^0.3.5"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Porro\\Filament\\FilamentConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/filament-connector/issues",
        "source": "https://github.com/Porrodev/filament-connector",
        "docs": "https://github.com/Porrodev/filament-connector#readme"
    },
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ]
}
